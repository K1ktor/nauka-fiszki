{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fiszki",
  "version": "0.9.6",
  "identifier": "pl.fiszki.nauka",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fiszki",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5NjMyQ0Q4MjdERTAwNTAKUldSUUFONG4yQ3hqQ2RXdThsZUdzaTJhSU1Wc0YvcENDbVBVK3ZuaWNNZDZ2OHJUajJWWWdTWSsK",
      "endpoints": [
        "https://github.com/K1ktor/nauka-fiszki/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
